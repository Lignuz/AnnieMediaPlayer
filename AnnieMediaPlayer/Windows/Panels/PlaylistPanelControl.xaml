<UserControl x:Class="AnnieMediaPlayer.Windows.Panels.PlaylistPanelControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:AnnieMediaPlayer"
             MinWidth="280">
    <UserControl.Resources>
        <Geometry x:Key="PlaybackSequentialIconData">M2,6 H18 M14.5,2.5 L18,6 L14.5,9.5 M2,14 H18 M14.5,10.5 L18,14 L14.5,17.5</Geometry>
        <Geometry x:Key="PlaybackShuffleIconData">M2,5 H5 C9,5 12,15 16,15 H19 M16,12 L19,15 L16,18 M2,15 H5 C7,15 8,12.5 9,11 M13,7 C14,5.7 15,5 16,5 H19 M16,2 L19,5 L16,8</Geometry>
        <Geometry x:Key="PlaylistRepeatIconData">M13,3 H7 C5.3,3 4,4.3 4,6 V14 C4,15.7 5.3,17 7,17 H13 C14.7,17 16,15.7 16,14 V7 M13,10 L16,7 L19,10</Geometry>
        <Style x:Key="PlaybackModeToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource TitleTextBrush}"/>
            <Setter Property="Focusable" Value="True"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <Border x:Name="HoverSurface" Background="Transparent" CornerRadius="4"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="3"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HoverSurface" Property="Background" Value="{DynamicResource ButtonHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Border Margin="8" Padding="12"
            Background="{DynamicResource BackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1">
        <DockPanel>
            <StackPanel DockPanel.Dock="Top">
                <WrapPanel>
                    <Button Style="{StaticResource MediaIconButtonStyle}" Content="{StaticResource PlaylistAddIconData}" ToolTip="{DynamicResource Text.Playlist.Add}" Width="34" Height="34" Margin="3" Click="AddButton_Click" />
                    <Button x:Name="RemoveButton" Style="{StaticResource MediaIconButtonStyle}" Content="{StaticResource PlaylistRemoveIconData}" ToolTip="{DynamicResource Text.Playlist.Remove}" Width="34" Height="34" Margin="3" Click="RemoveButton_Click" IsEnabled="False" />
                    <Button x:Name="PlaylistPlayPauseButton" IsEnabled="{Binding CanPlay}" Click="PlayPauseButton_Click" Width="34" Height="34" Margin="3">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource MediaIconButtonStyle}">
                                <Setter Property="Content" Value="{StaticResource PlayMediaIconData}" />
                                <Setter Property="ToolTip" Value="{DynamicResource Text.Play}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                        <Setter Property="Content" Value="{StaticResource PauseMediaIconData}" />
                                        <Setter Property="ToolTip" Value="{DynamicResource Text.Pause}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Height="34" Margin="3" ToolTip="{DynamicResource Text.Playlist.Clear}" Click="ClearButton_Click">
                        <StackPanel Orientation="Horizontal" Margin="10,4">
                            <Canvas Width="20" Height="20" Margin="0,0,5,0">
                                <Path Data="{StaticResource PlaylistClearIconData}" Stroke="{DynamicResource TitleTextBrush}" StrokeThickness="1" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent"/>
                            </Canvas>
                            <TextBlock Text="{DynamicResource Text.Playlist.Clear}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </WrapPanel>
                <Border Margin="3,8,3,0" Padding="8,6"
                        Background="{DynamicResource DataGridBackgroundBrush}"
                        BorderBrush="{DynamicResource DataGridBorderBrush}"
                        BorderThickness="1">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Playlist.CurrentItem}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Text="{DynamicResource Text.Playlist.Current}" FontWeight="SemiBold" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding Playlist.CurrentItem.FileName}"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Playlist.CurrentItem.FilePath}" />
                    </DockPanel>
                </Border>
            </StackPanel>

            <Border DockPanel.Dock="Bottom" Margin="3,8,3,0" Padding="0,8,0,0"
                    BorderBrush="{DynamicResource DataGridBorderBrush}" BorderThickness="0,1,0,0">
                <DockPanel LastChildFill="False">
                    <TextBlock DockPanel.Dock="Left" Text="{DynamicResource Text.Playback.Mode}"
                               VerticalAlignment="Center" Opacity="0.75"/>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <ToggleButton x:Name="RepeatModeButton" Style="{StaticResource PlaybackModeToggleButtonStyle}" Width="44" Height="30"
                                      Click="RepeatModeButton_Click">
                            <Grid Width="32" Height="24">
                                <Path x:Name="RepeatModeIcon" Data="{StaticResource PlaylistRepeatIconData}"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                      StrokeThickness="1.1" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Width="20" Height="20" HorizontalAlignment="Left" VerticalAlignment="Top" Stretch="Uniform"/>
                                <Border Width="15" HorizontalAlignment="Right" VerticalAlignment="Bottom" Padding="1,0"
                                        Background="Transparent">
                                    <TextBlock x:Name="RepeatModeBadge" Text="x" HorizontalAlignment="Center"
                                               FontSize="10.5" FontWeight="SemiBold"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
                                </Border>
                            </Grid>
                        </ToggleButton>
                        <ToggleButton x:Name="ShufflePlaybackButton" Style="{StaticResource PlaybackModeToggleButtonStyle}" Width="28" Height="30"
                                      IsChecked="{Binding CurrentOption.ShufflePlayback, Mode=TwoWay}"
                                      ToolTip="{DynamicResource Text.Playback.Shuffle.Off}"
                                      AutomationProperties.Name="{DynamicResource Text.Playback.Shuffle.Off}">
                            <Path x:Name="ShufflePlaybackIcon" Data="{StaticResource PlaybackSequentialIconData}"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                  StrokeThickness="1.35" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Width="17" Height="17" Stretch="Uniform"/>
                        </ToggleButton>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Grid x:Name="PlaylistHost" Margin="0,10,0,0">
                <ListBox x:Name="PlaylistList"
                         ItemsSource="{Binding Playlist.Items}"
                         TextSearch.TextPath="FileName"
                         SelectionMode="Extended"
                         Background="{DynamicResource DataGridBackgroundBrush}"
                         BorderBrush="{DynamicResource DataGridBorderBrush}"
                         Foreground="{DynamicResource DataGridForegroundBrush}"
                         BorderThickness="1"
                         HorizontalContentAlignment="Stretch"
                         AllowDrop="True"
                         SelectionChanged="PlaylistList_SelectionChanged"
                         PreviewMouseLeftButtonDown="PlaylistList_PreviewMouseLeftButtonDown"
                         PreviewMouseMove="PlaylistList_PreviewMouseMove"
                         DragOver="PlaylistList_DragOver"
                         DragLeave="PlaylistList_DragLeave"
                         Drop="PlaylistList_Drop"
                         MouseDoubleClick="PlaylistList_MouseDoubleClick"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Background" Value="{DynamicResource DataGridRowBackgroundBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource DataGridForegroundBrush}" />
                            <Setter Property="BorderBrush" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="1" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="ItemBorder"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                SnapsToDevicePixels="True">
                                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                              Content="{TemplateBinding Content}"
                                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                                              ContentStringFormat="{TemplateBinding ContentStringFormat}" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource DataGridMouseOverBackgroundBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource DataGridSelectionBackgroundBrush}" />
                                                <Setter Property="Foreground" Value="{DynamicResource DataGridSelectionForegroundBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Foreground" Value="{DynamicResource ButtonDisabledForegroundBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:PlaylistItemViewModel}">
                            <Grid Margin="2,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="3" Margin="0,0,6,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource ThemeButtonFillBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                                <Image Grid.Column="1" Width="16"
                                       Height="16"
                                       Margin="0,0,7,0"
                                       Source="{Binding FileTypeIcon}"
                                       VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2"
                                           Foreground="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=Foreground}"
                                           Text="{Binding FileName}"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding FilePath}" />
                                <Path Grid.Column="3" Width="12" Height="12" Margin="6,0,0,0"
                                      Data="{StaticResource PlayMediaIconData}" Fill="{DynamicResource ThemeButtonFillBrush}"
                                      Stretch="Uniform" VerticalAlignment="Center">
                                    <Path.Style>
                                        <Style TargetType="Path">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsCurrent}" Value="True" />
                                                        <Condition Binding="{Binding DataContext.IsPlaying, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="True" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                                <TextBlock Grid.Column="4"
                                           Margin="8,0,0,0"
                                           Foreground="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=Foreground}"
                                           Text="{Binding Duration, Converter={StaticResource PlaylistDurationFormatter}}"
                                           Opacity="0.7" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <Border x:Name="DropIndicator"
                        Height="2"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Background="{DynamicResource ThemeButtonFillBrush}"
                        Opacity="0.9"
                        Visibility="Collapsed"
                        IsHitTestVisible="False"
                        Panel.ZIndex="10">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="DropIndicatorTransform" />
                    </Border.RenderTransform>
                </Border>
            </Grid>
        </DockPanel>
    </Border>
</UserControl>
