<UserControl x:Class="AnnieMediaPlayer.Windows.Panels.PlaylistPanelControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:AnnieMediaPlayer"
             MinWidth="280">
    <Border Margin="8" Padding="12"
            Background="{DynamicResource BackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1">
        <DockPanel>
            <StackPanel DockPanel.Dock="Top">
                <TextBlock Text="{DynamicResource Text.Playlist}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10" />
                <WrapPanel>
                    <Button Content="{DynamicResource Text.Playlist.Add}" Click="AddButton_Click" />
                    <Button Content="{DynamicResource Text.Playlist.Remove}" Click="RemoveButton_Click" IsEnabled="False" x:Name="RemoveButton" />
                    <Button Content="{DynamicResource Text.Playlist.Clear}" Click="ClearButton_Click" />
                </WrapPanel>
            </StackPanel>

            <ListBox x:Name="PlaylistList"
                     Margin="0,10,0,0"
                     ItemsSource="{Binding Playlist.Items}"
                     SelectedItem="{Binding Playlist.CurrentItem, Mode=OneWay}"
                     HorizontalContentAlignment="Stretch"
                     SelectionChanged="PlaylistList_SelectionChanged"
                     MouseDoubleClick="PlaylistList_MouseDoubleClick"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:PlaylistItemViewModel}">
                        <Grid Margin="2,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" ToolTip="{Binding FilePath}" />
                            <TextBlock Grid.Column="1" Margin="8,0,0,0" Text="{Binding Duration, Converter={StaticResource PlaylistDurationFormatter}}" Opacity="0.7" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
    </Border>
</UserControl>
