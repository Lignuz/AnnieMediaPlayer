<base:BaseWindow x:Class="AnnieMediaPlayer.Windows.Info.UpdaterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:base="clr-namespace:AnnieMediaPlayer"
        xmlns:cons="clr-namespace:AnnieMediaPlayer.CustomControls"
        xmlns:local="clr-namespace:AnnieMediaPlayer.Windows.Info"
        mc:Ignorable="d"
        x:Name="uc"
        Title="{DynamicResource Text.Info.Version.Update.Check.Available}" Width="450" Height="270">
    <StackPanel>
        <!-- titlebar -->
        <cons:TitleBar TitleText="{Binding Path=Title, ElementName=uc}"/>

        <StackPanel Margin="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource Text.Info.Version.Local}" FontWeight="Bold"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{x:Static base:AppVersionHelper.Version}" Margin="10,0,0,0"/>
                <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource Text.Info.Version.Online}" FontWeight="Bold"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ServerVersion}" Margin="10,0,0,0"/>
            </Grid>
            <TextBox x:Name="UpdateDescriptionTextBox"
                 TextWrapping="Wrap"
                 Margin="0,10"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 IsReadOnly="True"
                 Height="100"
                 Text="{Binding ReleaseNote}"/>
            <DockPanel>
                <Button x:Name="UpdateButton" Content="{DynamicResource Text.Info.Update}" DockPanel.Dock="Right" Padding="10" Click="Update_Click"/>
                <Grid>
                    <ProgressBar x:Name="ProgressBar" Height="10" Margin="10,0" Value="{Binding Path=ProgressValue}" IsIndeterminate="{Binding Path=IsProgressIndeterminate}" Visibility="{Binding Path=ProgressVisibility, Mode=OneWay}"/>
                    <TextBlock Text="{Binding Path=ErrorMessage}" Visibility="{Binding ElementName=ProgressBar, Path=IsVisible, Converter={StaticResource BooleanToVisibilityInvertedConverter}}"/>
                </Grid>
            </DockPanel>
        </StackPanel>
    </StackPanel>
</base:BaseWindow>
