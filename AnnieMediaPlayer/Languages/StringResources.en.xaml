    <sys:String x:Key="Text.Shortcut.F1.Description">Opens the program information window. If update settings are configured and no result is available yet (or the previous check failed), it checks for updates.</sys:String>
    <sys:String x:Key="Text.Shortcut.Space.Shortcut">Space</sys:String>
    <sys:String x:Key="Text.Shortcut.Space.Action">Open / Play and Pause</sys:String>
    <sys:String x:Key="Text.Shortcut.Space.Description">If no media is open, plays the current playlist item (or the first item). Opens a file if the playlist is empty. Otherwise toggles play and pause.</sys:String>
    <sys:String x:Key="Text.Shortcut.CtrlSpace.Shortcut">Ctrl + Space</sys:String>
    <sys:String x:Key="Text.Shortcut.CtrlSpace.Action">Stop</sys:String>
    <sys:String x:Key="Text.Shortcut.CtrlSpace.Description">Stops the currently playing media.</sys:String>
    <sys:String x:Key="Text.Shortcut.LeftArrow.Shortcut">←\n(Left Arrow)</sys:String>
    <sys:String x:Key="Text.Shortcut.LeftArrow.Action">Move 1 frame back</sys:String>
    <sys:String x:Key="Text.Shortcut.LeftArrow.Description">Moves back 1 frame when media is paused. If the playlist list has focus, it moves the list selection instead.</sys:String>
    <sys:String x:Key="Text.Shortcut.RightArrow.Shortcut">→\n(Right Arrow)</sys:String>
    <sys:String x:Key="Text.Shortcut.RightArrow.Action">Move 1 frame forward</sys:String>
    <sys:String x:Key="Text.Shortcut.RightArrow.Description">Moves forward 1 frame when media is paused. If the playlist list has focus, it moves the list selection instead.</sys:String>
    <sys:String x:Key="Text.Shortcut.Tab.Shortcut">Tab</sys:String>
    <sys:String x:Key="Text.Shortcut.Tab.Action">Toggle Properties Panel</sys:String>
    <sys:String x:Key="Text.Shortcut.Tab.Description">In the main window, shows or hides the playback properties panel on the right. In the playlist window, Tab keeps its normal focus-navigation behavior.</sys:String>
    <sys:String x:Key="Text.Shortcut.Enter.Shortcut">Enter</sys:String>
    <sys:String x:Key="Text.Shortcut.Enter.Action">Toggle Fullscreen / Play Item</sys:String>
    <sys:String x:Key="Text.Shortcut.Enter.Description">In the main window, switches between fullscreen and normal view. In the playlist window, plays the selected item when the list has focus.</sys:String>
    <sys:String x:Key="Text.Shortcut.OemTilde.Shortcut">~ / ` (OemTilde)</sys:String>
    <sys:String x:Key="Text.Shortcut.OemTilde.Action">Restore Minimum Window Size</sys:String>
    <sys:String x:Key="Text.Shortcut.OemTilde.Description">Sets the window to its minimum size and switches to normal window state.</sys:String>
    <sys:String x:Key="Text.Shortcut.D1.Shortcut">1</sys:String>
    <sys:String x:Key="Text.Shortcut.D1.Action">Set Window Size to 640 × 480</sys:String>
    <sys:String x:Key="Text.Shortcut.D1.Description">Sets the window to 640 × 480 and switches to normal window state. Use 1 on the number row; the numeric keypad key is not included.</sys:String>
    <sys:String x:Key="Text.Shortcut.D2.Shortcut">2</sys:String>
    <sys:String x:Key="Text.Shortcut.D2.Action">Set Window Size to 1280 × 960</sys:String>
    <sys:String x:Key="Text.Shortcut.D2.Description">Sets the window to 1280 × 960 and switches to normal window state. Use 2 on the number row; the numeric keypad key is not included.</sys:String>
